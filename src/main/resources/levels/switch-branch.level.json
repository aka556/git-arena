    "title": "切换分支",
    "description": "main 和 feature 都指向 C2，HEAD 在 main。切换到 feature，让 HEAD 移过去（分支指向都不变）。",
    "category": "branching",
    "difficulty": 2,
    "mode": "solo",
    "orderIndex": 2
  },
  "initial": {
    "commits": [
      { "seq": "C1", "parents": [], "message": "c1", "files": { "a.txt": "1\n" } },

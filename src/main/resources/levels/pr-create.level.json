    "remotes": [
      { "name": "origin", "branches": [ { "name": "main", "target": "C1", "tracked": "C1" } ] }
    ]
  },
  "goal": {
    "graph": {
      "commits": [
        { "seq": "C1", "parents": [] },
        { "seq": "C2", "parents": ["C1"] }

      { "seq": "C1", "parents": [], "message": "base", "files": { "app.txt": "v1\n" } },
      { "seq": "C2", "parents": ["C1"], "message": "feature work", "files": { "feature.txt": "done\n" } }
    ],
    "branches": [
      { "name": "main", "target": "C1" },
      { "name": "feature", "target": "C2" }
    ],

{
  "specVersion": 1,
  "meta": {
    "slug": "checkout-head-caret",
    "title": "用 HEAD^ 回到上一个提交",
    "description": "main 上有 C1 → C2 → C3。使用 HEAD^ 选择 HEAD 的第一个父提交回到 C2，并进入 detached HEAD。",
    "category": "basics",
    "difficulty": 2,
    "mode": "solo",
    "orderIndex": 7
  },
  "initial": {
    "commits": [
      { "seq": "C1", "parents": [], "message": "c1", "files": { "a.txt": "1\n" } },
      { "seq": "C2", "parents": ["C1"], "message": "c2", "files": { "a.txt": "2\n" } },
      { "seq": "C3", "parents": ["C2"], "message": "c3", "files": { "a.txt": "3\n" } }
    ],
    "branches": [ { "name": "main", "target": "C3" } ],
    "head": { "type": "branch", "ref": "main" }
  },
  "goal": {
    "graph": {
      "commits": [
        { "seq": "C1", "parents": [] },
        { "seq": "C2", "parents": ["C1"] },
        { "seq": "C3", "parents": ["C2"] }
      ],
      "branches": [ { "name": "main", "target": "C3" } ],
      "head": { "type": "detached", "ref": "C2" }
    }
  },
  "solution": {
    "steps": [
      { "run": "git checkout HEAD^" }
    ],
    "notes": "HEAD^ 表示 HEAD 的第一个父提交。在只有一个父提交的线性历史里，HEAD^ 与 HEAD~ 指向同一个提交。"
  },
  "hints": [
    { "tier": 1, "body": "^ 可以选择一个提交的父提交；^ 默认选择第一个父提交", "costPoints": 0 },
    { "tier": 2, "body": "git checkout HEAD^ 会回到 HEAD 的第一个父提交", "costPoints": 5 }
  ]
}
